# Exemplo local. Em produção, todas estas variáveis ficam só na Vercel (nunca no repositório).

# Neon — ligação com pooling (runtime) e directa (migrações). A integração Neon da Vercel cria
# DATABASE_URL e DATABASE_URL_UNPOOLED: copiar esta última para DIRECT_URL.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/fitnessclub?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/fitnessclub?sslmode=require"
# Auth.js — gerar com `npx auth secret` ou `openssl rand -base64 32`
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# URL pública do app (links nos emails)
APP_URL="http://localhost:3000"

# Inngest — aviso de fim de descanso. Em dev: npx inngest-cli@latest dev
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
# Só em desenvolvimento, com o dev server do Inngest a correr
# INNGEST_DEV="1"

# Upstash Redis — rate limit (login, recuperação, exportação, push de teste)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Web Push — gerar um par novo com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:ola@exemplo.com"

# Email transaccional — Resend. Sem RESEND_API_KEY fora de produção, os emails ficam em memória e na consola.
RESEND_API_KEY=""
EMAIL_FROM="FitnessClub <ola@exemplo.com>"
EMAIL_REPLY_TO="privacidade@onda.work"

# Versões dos documentos legais: mudar pede re-aceitação a todos os utilizadores
LEGAL_TERMS_VERSION="2026-11-19.2"
LEGAL_PRIVACY_VERSION="2026-11-19.2"
# Administração (/admin): emails com acesso, separados por vírgulas (vazio = ninguém)
ADMIN_EMAILS=""

# Sentry (erros; projecto na região UE). Vazio = desligado. O token só na Vercel (source maps no build)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Imagens dos exercícios no Vercel Blob (só para scripts/fitness/import-images.ts; não é preciso em runtime)
BLOB_READ_WRITE_TOKEN=""

# IA (Fase B): Gemini 3.8 Flash. A chave só na Vercel (Secret). Em dev, AI_FAKE=1 responde sem chave.
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-3.8-flash"
# AI_FAKE="1"
