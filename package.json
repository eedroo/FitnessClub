{
  "name": "fitnessclub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && prisma migrate deploy && tsx prisma/seed-exercises.ts && next build",
    "seed:exercises": "tsx prisma/seed-exercises.ts",
    "fitness:translate": "tsx scripts/fitness/translate.ts",
    "fitness:images": "tsx scripts/fitness/import-images.ts",
    "copy:my-data": "tsx scripts/copy-my-data.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@react-email/components": "^1.0.12",
    "@sentry/nextjs": "^11.9.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^0.27.3",
    "bcryptjs": "^3.0.3",
    "inngest": "^3.54.2",
    "lucide-react": "^0.577.0",
    "luxon": "^3.7.2",
    "next": "14.2.35",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^3.26.5",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.32.0",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.5",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/web-push": "^3.6.4",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "prisma": "^6.19.3",
    "sharp": "^0.33.5",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  }
}
