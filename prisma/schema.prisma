generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ThemePref {
  LIGHT
  DARK
  SYSTEM
}

enum Locale {
  PT_PT
  PT_BR
  EN
}

// Plano e interruptor de premium (sem pagamentos ainda)
enum Plan {
  FREE
  PREMIUM
}

enum PlanSource {
  MANUAL
  GIFT
  PAID // para quando houver pagamentos
}

enum FeatureRollout {
  HIDDEN
  PREMIUM
  ALL
}

enum NotificationKind {
  // Fim do descanso numa sessão de treino (só push; periodKey = sessionId:restEndsAt)
  REST_DONE
}

model User {
  id                 String      @id @default(cuid())
  email              String      @unique
  passwordHash       String
  name               String
  locale             Locale      @default(PT_PT)
  theme              ThemePref   @default(SYSTEM) // segue o tema do iPhone por defeito
  timezone           String      @default("Europe/Lisbon")
  onboardedAt        DateTime? // boas-vindas do treino concluídas
  emailVerifiedAt    DateTime?
  sessionVersion     Int         @default(0) // incrementar invalida todos os JWT
  termsAcceptedAt    DateTime?
  termsVersion       String? // ex.: "2026-11"
  privacyVersion     String?
  wellbeingConsentAt DateTime? // consentimento explícito para dados de saúde (peso e meta)
  aiConsentAt        DateTime? // consentimento para enviar dados de treino à IA (Fase B)
  lastActiveAt       DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  // Plano (lido do servidor por pedido, nunca no JWT) e excepções por funcionalidade
  plan               Plan        @default(FREE)
  planSource         PlanSource?
  planSince          DateTime?
  planExpiresAt      DateTime? // null = sem fim
  premiumRequestedAt DateTime? // pediu o Premium no app (o admin vê a lista e liberta); limpo ao passar a Premium
  isBot              Boolean     @default(false) // conta de demonstração (bot), sempre com a etiqueta «Bot»; sem login

  authTokens        AuthToken[]
  pushSubscriptions PushSubscription[]
  notificationLogs  NotificationLog[]
  activeDays        UserActiveDay[]
  featureOverrides  FeatureOverride[]
  // Treino e peso
  fitnessPrefs      FitnessPrefs?
  customExercises   Exercise[]
  fitnessPrograms   FitnessProgram[]
  fitnessSessions   FitnessSession[]
  bodyWeights       BodyWeightEntry[]
  bodyGoal          BodyGoal?
  exerciseNotes     ExerciseNote[]
  trainingProfile   TrainingProfile?
  aiRequests        AiRequest[]
  activities        Activity[]
  // Rede social (Fase C)
  socialProfile     SocialProfile?
  friendRequestsOut Friendship[]       @relation("FriendRequester")
  friendRequestsIn  Friendship[]       @relation("FriendAddressee")
  blocksMade        Block[]            @relation("Blocker")
  blocksReceived    Block[]            @relation("Blocked")
  posts             Post[]
  postLikes         PostLike[]
  postComments      PostComment[]
  reports           Report[]
  socialNotices     SocialNotice[]     @relation("NoticeTo")
  socialNoticesSent SocialNotice[]     @relation("NoticeFrom")
  groupsOwned       Group[]
  groupMemberships  GroupMember[]
  invitesHosted     WorkoutInvite[]
  inviteGuests      InviteGuest[]
  leagueResults     LeagueResult[]
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
  EMAIL_CHANGE
}

// Tokens de email (confirmação, recuperação, alteração): só o hash SHA-256; uso único; com expiração.
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique
  newEmail  String? // só EMAIL_CHANGE
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
}

// Avisos enviados (idempotência por (userId, kind, periodKey))
model NotificationLog {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      NotificationKind
  periodKey String
  sentAt    DateTime         @default(now())
  title     String
  body      String
  url       String
  pushed    Boolean          @default(false) // enviado por push com sucesso a ≥ 1 dispositivo

  @@unique([userId, kind, periodKey])
  @@index([userId, sentAt])
}

// Um registo por dia em que a pessoa abriu o app (métricas do admin)
model UserActiveDay {
  userId String
  day    DateTime @db.Date // data no fuso do utilizador
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@index([day])
}

// Estado global de cada funcionalidade (sem linha = valor por defeito do código)
// Definições globais da app (chave → valor JSON), mudadas no admin sem novo deploy. Ex.: `bots` = { visible }.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model FeatureFlag {
  key       String         @id
  rollout   FeatureRollout
  updatedAt DateTime       @updatedAt
}

// Excepção por pessoa
model FeatureOverride {
  userId    String
  key       String
  enabled   Boolean
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
}

// ─── Treino: exercícios, programas, treinos, sessões e séries ────────────────────────────────────
enum ExerciseSource {
  LIBRARY
  CUSTOM
}

enum ExerciseMeasure {
  REPS_WEIGHT // kg + reps
  REPS // só reps (peso corporal)
  DURATION // tempo
}

enum ProgramKind {
  STRENGTH
  STRETCH
  MIXED
}

model Exercise {
  id               String          @id // LIBRARY: id da free-exercise-db; CUSTOM: cuid
  source           ExerciseSource
  ownerId          String? // só CUSTOM
  names            Json // { en, "pt-PT", "pt-BR" }
  category         String
  measure          ExerciseMeasure
  primaryMuscles   String[]
  secondaryMuscles String[]
  equipment        String?
  level            String?
  instructions     Json? // { en: string[], "pt-PT"?: string[], "pt-BR"?: string[] }
  images           String[] // URLs no Vercel Blob
  defaultRestSec   Int?
  archivedAt       DateTime?
  owner            User?           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  workoutItems     WorkoutItem[]
  sets             SessionSet[]
  notes            ExerciseNote[]

  @@index([ownerId])
}

enum WeighInFrequency {
  OFF
  DAILY
  WEEKLY
}

model FitnessPrefs {
  userId           String           @id
  defaultRestSec   Int              @default(90)
  restAlert        Boolean          @default(true) // aviso de fim de descanso
  keepAwake        Boolean          @default(true) // manter o ecrã ligado durante o treino
  weighInReminder  Boolean          @default(false) // obsoleto: substituído por weighInFrequency (copiado na migração weigh_in)
  weighInFrequency WeighInFrequency @default(OFF) // pedir o peso ao abrir a app: nunca, todos os dias ou uma vez por semana
  weighInTime      String           @default("08:00")
  aiWeeklyInsights Boolean          @default(true) // retrospectiva semanal da IA (com o recurso `ai` e o consentimento)
  tourDoneAt       DateTime? // tour de boas-vindas do app visto (ou saltado)
  badgesSeen       String[]         @default([]) // emblemas já celebrados (o pop-up mostra só os novos)
  badgesSeenAt     DateTime? // última verificação; null = ainda não (os emblemas que já tinha não dão pop-up)
  onboardedAt      DateTime?
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FitnessProgram {
  id          String           @id @default(cuid())
  userId      String
  name        String
  description String?
  kind        ProgramKind      @default(STRENGTH)
  notes       String? // notas do programa (da pessoa ou geradas pela IA)
  notesByAi   Boolean          @default(false)
  order       Int
  archivedAt  DateTime?
  createdAt   DateTime         @default(now())
  workouts    FitnessWorkout[]
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model FitnessWorkout {
  id         String           @id @default(cuid())
  programId  String
  userId     String
  name       String
  notes      String? // notas do treino (da pessoa ou geradas pela IA)
  notesByAi  Boolean          @default(false)
  order      Int
  archivedAt DateTime?
  items      WorkoutItem[]
  sessions   FitnessSession[]
  program    FitnessProgram   @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WorkoutItem {
  id            String         @id @default(cuid())
  workoutId     String
  exerciseId    String
  order         Int
  targetSets    Int?
  targetRepsMin Int?
  targetRepsMax Int?
  targetSec     Int? // exercícios DURATION
  restSec       Int? // sobrepõe o descanso por defeito
  notes         String?
  workout       FitnessWorkout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise      Exercise       @relation(fields: [exerciseId], references: [id])

  @@index([workoutId])
}

model FitnessSession {
  id             String          @id @default(cuid())
  userId         String
  workoutId      String? // null = treino livre
  date           DateTime        @db.Date // dia local do início
  startedAt      DateTime
  endedAt        DateTime?
  restEndsAt     DateTime? // descanso em curso
  restExerciseId String?
  clientHidden   Boolean         @default(false) // app em segundo plano (para decidir o push)
  extraExercises String[] // "+ Exercício" na sessão (não muda o treino guardado)
  notes          String?
  sets           SessionSet[]
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout        FitnessWorkout? @relation(fields: [workoutId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
}

model SessionSet {
  id          String         @id @default(cuid())
  sessionId   String
  userId      String
  exerciseId  String
  order       Int
  reps        Int?
  weightGrams Int?
  durationSec Int?
  completedAt DateTime
  restSec     Int? // descanso usado depois desta série
  prKinds     String[]       @default([]) // recordes batidos nesta série ('weight' | 'e1rm' | 'reps')
  session     FitnessSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise    Exercise       @relation(fields: [exerciseId], references: [id])

  @@index([userId, exerciseId, completedAt])
  @@index([sessionId])
}

// ─── Peso diário e meta (dados de saúde, com consentimento) ─────────────────────────────────────────────────

enum BodyGoalDirection {
  GAIN
  MAINTAIN
  LOSE
}

model BodyWeightEntry {
  userId    String
  date      DateTime @db.Date // dia local; 1 registo por dia (o último substitui)
  grams     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, date])
}

model BodyGoal {
  userId          String            @id
  direction       BodyGoalDirection
  weeklyRateGrams Int // valor absoluto; MAINTAIN = 0
  targetGrams     Int?
  startGrams      Int // média da semana em que o objectivo foi criado
  startedAt       DateTime          @default(now())
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── F18: Modo guiado ────────────────────────────────────────────────────────────────────────────

// Notas pessoais de um exercício: uma por pessoa e exercício (biblioteca ou próprio), escritas por ela ou pela IA.
model ExerciseNote {
  userId     String
  exerciseId String
  text       String
  byAi       Boolean  @default(false)
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@id([userId, exerciseId])
}

enum TrainingLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

// Perfil de treino (onboarding e definições): o que a IA usa para montar programas e analisar a semana.
model TrainingProfile {
  userId         String        @id
  goals          String[] // strength | hypertrophy | fat_loss | endurance | health | sport (src/lib/fitness/profile.ts)
  level          TrainingLevel @default(BEGINNER)
  equipment      String[] // full_gym | free_weights | home_basic | bodyweight | outdoor | bands
  focusMuscles   String[] // partes do mapa muscular (src/lib/body/muscles.ts)
  trainingDays   Int[] // 0 = domingo … 6 = sábado
  sessionMinutes Int?
  wishes         String? // comentários, sugestões, o que quer
  avoid          String? // o que não quer (exercícios de que não gosta, limitações)
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Fase B: IA (Gemini) ─────────────────────────────────────────────────────────────────────────

enum AiKind {
  PROGRAM // programa proposto a partir do perfil de treino
  INSIGHT // retrospectiva da semana
}

enum AiStatus {
  PENDING
  DONE
  FAILED
  APPLIED // programa guardado
  DISCARDED
}

// Cada pedido à IA: o resultado validado, o custo e os tokens (admin). Nunca guarda o prompt com dados pessoais.
model AiRequest {
  id           String    @id @default(cuid())
  userId       String
  kind         AiKind
  status       AiStatus  @default(PENDING)
  weekStart    DateTime? @db.Date // INSIGHT: domingo da semana analisada
  facts        Json? // INSIGHT: os números calculados pela app (a IA só os interpreta)
  result       Json? // saída validada com Zod
  error        String?
  model        String?
  inputTokens  Int       @default(0)
  outputTokens Int       @default(0)
  costMicroUsd Int       @default(0) // milionésimos de dólar
  readAt       DateTime?
  createdAt    DateTime  @default(now())
  finishedAt   DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, weekStart])
  @@index([userId, kind, createdAt])
  @@index([createdAt])
}

// ─── Atividades (tipos do app Saúde do iPhone): registo manual de outros treinos ────────────────────

model Activity {
  id             String   @id @default(cuid())
  userId         String
  type           String // chave de src/lib/activities/types.ts (ex.: running, yoga, swimming)
  date           DateTime @db.Date // dia local do início
  startedAt      DateTime
  durationSec    Int
  effort         Int? // 1–10 (como o "Esforço" do app Fitness)
  distanceMeters Int? // só tipos com distância
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, startedAt])
}

// ─── Fase C: rede social ─────────────────────────────────────────────────────────────────────────

// Perfil público: só existe depois de a pessoa entrar na comunidade (escolhe o @ e aceita as regras).
// Pódio de uma semana do ranking por ligas (os 3 primeiros de cada liga), gravado ao fechar a semana.
model LeagueResult {
  id        String   @id @default(cuid())
  userId    String
  weekStart DateTime @db.Date // domingo da semana
  league    String // bronze, silver, gold, platinum, diamond
  rank      Int // 1, 2 ou 3
  xp        Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@index([weekStart])
}

model SocialProfile {
  userId      String   @id
  handle      String   @unique // minúsculas, 3–20 de [a-z0-9_.]
  displayName String
  bio         String?
  shareLevels Boolean  @default(false) // mostrar os níveis de força no perfil (desligado por defeito)
  avatarUrl   String? // foto de perfil no Vercel Blob (avatars/<userId>/…)
  inRanking   Boolean  @default(true) // aparece no ranking semanal por ligas (e recebe os avisos dele)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

// Amizade mútua: pedido (requester → addressee) e aceitação.
model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  acceptedAt  DateTime?
  requester   User             @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

// Bloqueio: nenhum dos dois vê o outro (perfil, posts, comentários, pesquisa).
model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

enum PostVisibility {
  PUBLIC
  FRIENDS
}

model Post {
  id         String         @id @default(cuid())
  authorId   String
  text       String?
  visibility PostVisibility @default(FRIENDS)
  // Treino partilhado: um retrato do resumo no momento (o post não muda se a sessão for editada).
  sessionId  String?
  activityId String?
  workout    Json?
  images     String[]       @default([]) // até 4 fotos no Vercel Blob (posts/<userId>/…)
  carousel   Boolean        @default(false) // fotos + anexo em carrossel (a foto na capa, o anexo editorial a seguir)
  createdAt  DateTime       @default(now())
  hiddenAt   DateTime? // escondido pela moderação
  author     User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes      PostLike[]
  comments   PostComment[]

  @@index([authorId, createdAt])
  @@index([visibility, createdAt])
}

model PostLike {
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
}

model PostComment {
  id        String    @id @default(cuid())
  postId    String
  authorId  String
  text      String
  createdAt DateTime  @default(now())
  hiddenAt  DateTime?
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

enum ReportTarget {
  POST
  COMMENT
  USER
}

model Report {
  id         String       @id @default(cuid())
  reporterId String
  target     ReportTarget
  targetId   String
  reason     String
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([resolvedAt, createdAt])
}

enum SocialNoticeKind {
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  LIKE
  COMMENT
  INVITE // convidaram-me para um treino
  INVITE_REQUEST // alguém quer ir ao meu treino
  INVITE_ACCEPTED // o anfitrião aceitou-me / aceitaram o meu convite
}

// Avisos da comunidade dentro da app (sino do Feed).
model SocialNotice {
  id        String           @id @default(cuid())
  userId    String
  actorId   String
  kind      SocialNoticeKind
  postId    String?
  inviteId  String?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation("NoticeTo", fields: [userId], references: [id], onDelete: Cascade)
  actor     User             @relation("NoticeFrom", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

// ─── Fase C3: grupos com meta semanal e ranking ──────────────────────────────────────────────────

enum GroupGoalKind {
  SESSIONS // treinos (sessões + atividades) por pessoa e semana
  MINUTES // minutos de treino por pessoa e semana
  XP // XP por pessoa e semana
}

model Group {
  id          String        @id @default(cuid())
  name        String
  description String?
  ownerId     String
  isPublic    Boolean       @default(false) // público: aparece na lista e entra-se logo; privado: só com o link
  code        String        @unique // código do link de convite
  goalKind    GroupGoalKind @default(SESSIONS)
  goalTarget  Int           @default(3)
  createdAt   DateTime      @default(now())
  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members     GroupMember[]

  @@index([isPublic, createdAt])
}

model GroupMember {
  groupId  String
  userId   String
  joinedAt DateTime @default(now())
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

// ─── Fase C4: convites de treino com o local no mapa ─────────────────────────────────────────────

enum InviteVisibility {
  PUBLIC // qualquer pessoa com conta vê e pode pedir para ir
  FRIENDS // os amigos do anfitrião
  DIRECT // só as pessoas convidadas
}

enum GuestStatus {
  INVITED // o anfitrião convidou; falta a resposta
  REQUESTED // pediu para ir; falta o anfitrião aceitar
  GOING
  DECLINED
}

// Treino marcado: o local é uma academia ou uma região escolhida numa pesquisa (nunca a posição GPS de ninguém).
model WorkoutInvite {
  id           String           @id @default(cuid())
  hostId       String
  title        String
  description  String?
  activityType String // chave de src/lib/activities/types.ts
  startsAt     DateTime
  durationMin  Int?
  placeName    String
  placeLat     Float // arredondado a ~100 m
  placeLng     Float
  visibility   InviteVisibility @default(FRIENDS)
  maxPeople    Int?
  canceledAt   DateTime?
  createdAt    DateTime         @default(now())
  host         User             @relation(fields: [hostId], references: [id], onDelete: Cascade)
  guests       InviteGuest[]

  @@index([startsAt])
  @@index([hostId, startsAt])
}

model InviteGuest {
  inviteId  String
  userId    String
  status    GuestStatus
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  invite    WorkoutInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([inviteId, userId])
  @@index([userId, status])
}
